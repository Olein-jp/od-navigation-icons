<?xml version="1.0"?>
<ruleset name="OD Pagination Icons">
  <description>OD Pagination Icons の WordPress コーディング規約。</description>
  <file>od-pagination-icons.php</file>
  <arg name="extensions" value="php"/>
  <arg value="sp"/>
  <rule ref="WordPress"/>
  <rule ref="WordPress.WP.I18n">
    <properties>
      <property name="text_domain" type="array">
        <element value="od-pagination-icons"/>
      </property>
    </properties>
  </rule>
  <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
    <properties>
      <property name="prefixes" type="array">
        <element value="od_pagination_icons"/>
      </property>
    </properties>
  </rule>
</ruleset>
