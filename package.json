{
  "name": "od-pagination-icons",
  "version": "0.1.1",
  "private": true,
  "engines": {
    "node": ">=24.18.0"
  },
  "scripts": {
    "env:start": "wp-env start",
    "env:stop": "wp-env stop",
    "env:status": "wp-env status",
    "env:logs": "wp-env logs",
    "env:cli": "wp-env run cli wp",
    "i18n:pot": "wp-env run cli --env-cwd=wp-content/plugins/od-pagination-icons wp i18n make-pot . languages/od-pagination-icons.pot --domain=od-pagination-icons --exclude=vendor,node_modules,dist,tests",
    "i18n:mo": "wp-env run cli --env-cwd=wp-content/plugins/od-pagination-icons wp i18n make-mo languages",
    "release:build": "python3 scripts/build-release.py",
    "build": "wp-scripts build",
    "start": "wp-scripts start",
    "lint:js": "wp-scripts lint-js src tests/js",
    "lint:css": "wp-scripts lint-style \"src/**/*.scss\"",
    "test:js": "wp-scripts test-unit-js --runInBand",
    "test:php": "wp-env run cli wp eval-file wp-content/plugins/od-pagination-icons/tests/php/integration.php",
    "test:e2e": "playwright test",
    "format": "wp-scripts format src tests/js",
    "check": "npm run lint:js && npm run lint:css && npm run test:js && npm run build",
    "test:e2e:setup": "wp-env run cli wp eval-file wp-content/plugins/od-pagination-icons/tests/e2e/setup.php",
    "test:e2e:cleanup": "wp-env run cli wp eval-file wp-content/plugins/od-pagination-icons/tests/e2e/cleanup.php",
    "i18n:json": "wp-env run cli --env-cwd=wp-content/plugins/od-pagination-icons wp i18n make-json languages --no-purge"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@wordpress/env": "^12.1.0",
    "@wordpress/scripts": "^35.0.0"
  },
  "dependencies": {
    "@wordpress/api-fetch": "^8.1.0",
    "@wordpress/block-editor": "^20.0.0",
    "@wordpress/components": "^44.0.0",
    "@wordpress/data": "^11.1.0",
    "@wordpress/element": "^10.1.0",
    "@wordpress/hooks": "^5.1.0",
    "@wordpress/i18n": "^7.1.0"
  }
}
