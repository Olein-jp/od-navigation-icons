#. Plugin Name of the plugin
#: od-navigation-icons.php
msgid "OD Navigation Icons"
msgstr "OD Navigation Icons"

#. Plugin URI of the plugin
#: od-navigation-icons.php
msgid "https://github.com/Olein-jp/od-navigation-icons"
msgstr "https://github.com/Olein-jp/od-navigation-icons"

#. Description of the plugin
#: od-navigation-icons.php
msgid "Choose registered WordPress icons and sizes for Query Pagination and Post Navigation links."
msgstr ""
"ページ送りと前後の投稿リンクに、WordPress に登録されたアイコンとサイズを設定します。"

#. Author of the plugin
#: od-navigation-icons.php
msgid "Koji Kuno"
msgstr "Koji Kuno"

#. Author URI of the plugin
#: od-navigation-icons.php
msgid "https://olein-design.com"
msgstr "https://olein-design.com"

#: od-navigation-icons.php:75
msgid ""
"OD Navigation Icons: Dependencies are missing. Run composer install in the "
"plugin directory or install the ZIP from GitHub Releases."
msgstr ""
"OD Navigation Icons: 依存ライブラリが見つかりません。プラグインのディレクトリ"
"で composer install を実行するか、GitHub Releases の ZIP をインストールしてく"
"ださい。"

#: build/index.js:1 src/editor/IconPicker.js:49
msgid "Icon library"
msgstr "アイコンライブラリ"

#: build/index.js:1 src/editor/IconPicker.js:56
msgid "Could not load icons. Check your connection and permissions."
msgstr "アイコンを取得できませんでした。接続と権限を確認してください。"

#: build/index.js:1 src/editor/IconPicker.js:64
msgid "Retry"
msgstr "再試行"

#: build/index.js:1 src/editor/IconPicker.js:71
msgid "Search icons"
msgstr "アイコンを検索"

#. translators: %d: number of matching icons.
#: build/index.js:2 src/editor/IconPicker.js:114
msgid "%d icons found"
msgstr "%d 件のアイコン"

#: build/index.js:2 src/editor/IconPicker.js:159
msgid "No results found."
msgstr "見つかりませんでした。"

#: build/index.js:2 src/editor/IconPicker.js:174
msgid "Previous results"
msgstr "前の結果"

#. translators: 1: current page, 2: total pages.
#: build/index.js:3 src/editor/IconPicker.js:182
msgid "%1$d / %2$d"
msgstr "%1$d / %2$d"

#: build/index.js:3 src/editor/IconPicker.js:197
msgid "Next results"
msgstr "次の結果"

#: build/index.js:3 src/editor/IconPicker.js:231
msgid ""
"This icon is unavailable. The standard arrow will be used; the saved "
"selection is retained."
msgstr ""
"このアイコンは取得できません。標準矢印を表示します。保存済みの選択は保持され"
"ます。"

#: build/index.js:3 src/editor/IconPicker.js:238
msgid "Choose icon"
msgstr "アイコンを選択"

#: build/index.js:3 src/editor/IconPicker.js:242
msgid "Clear selection"
msgstr "選択を解除"

#: build/index.js:3 src/editor/extend-block.js:68
msgid "Custom icons"
msgstr "カスタムアイコン"

#: build/index.js:3 src/editor/extend-block.js:74
msgid "Use custom icons"
msgstr "カスタムアイコンを使用"

#: build/index.js:3 src/editor/extend-block.js:86
msgid ""
"Custom mode overrides the standard arrow display. Disabling it restores your "
"standard arrow setting. An empty selection uses the standard arrow."
msgstr ""
"カスタムモードでは標準矢印の表示を上書きします。無効にすると元の矢印設定に戻"
"ります。未選択の場合は標準矢印を使います。"

#: build/index.js:3 src/editor/extend-block.js:93
msgid ""
"For icons without text, first choose Arrow or Chevron in the standard arrow "
"setting, then turn off Show label text."
msgstr ""
"アイコンのみ表示するには、標準矢印で「矢印」または「シェブロン」を選び、ラベ"
"ルのテキストを非表示にしてください。"

#: build/index.js:3 src/editor/extend-block.js:100
msgid "Previous page icon"
msgstr "前のページのアイコン"

#: build/index.js:3 src/editor/extend-block.js:112
msgid "Next page icon"
msgstr "次のページのアイコン"

#: build/index.js:3 src/editor/extend-block.js
msgid "Post link icon"
msgstr "投稿リンクのアイコン"

#: build/index.js:3 src/editor/IconSizeControl.js
msgid "Icon size"
msgstr "アイコンサイズ"

#: build/index.js:3 src/editor/IconSizeControl.js
msgid "Size unit"
msgstr "サイズの単位"

#: build/index.js:3 src/editor/IconSizeControl.js
msgid "Leave empty to match the text size."
msgstr "空欄にすると文字サイズに合わせます。"

#: build/index.js:3 src/editor/extend-block.js
msgid "Show icon only"
msgstr "アイコンのみ表示"

#: build/index.js:3 src/editor/extend-block.js
msgid "The icon remains clickable. Link text is kept for screen readers."
msgstr "アイコンをクリックして移動できます。リンクの文字は読み上げ用に残します。"

#: includes/render.php
msgid "Previous post"
msgstr "前の投稿"

#: includes/render.php
msgid "Next post"
msgstr "次の投稿"
